# Maternity HL7-to-FHIR Pipeline - Environment Configuration
# Copy this file to .env and adjust values as needed.

# FastAPI Configuration
HAPI_BASE_URL=http://hapi:8080/fhir
LOG_LEVEL=INFO
MRN_SYSTEM=http://hospital.local/mrn

# Set to "true" to validate resources via HAPI $validate before persisting.
# Requires loaded StructureDefinitions for meaningful profile validation.
VALIDATE_BEFORE_PERSIST=false

# Profile region: "au" (Australian, default) or "eu" (European)
PROFILE_REGION=au

# EU sub-configuration: country code for national identifier system
# Options: uk, nl, de, ie (leave empty for generic EU)
# Only used when PROFILE_REGION=eu
PROFILE_COUNTRY=

# HAPI FHIR Configuration
# Database: H2 (embedded) for demo - swap to Postgres for production.
# See hapi/application.yaml for additional HAPI settings.
